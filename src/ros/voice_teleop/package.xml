<?xml version="1.0"?>
<package format="3">
  <name>voice_teleop</name>
  <version>0.1.0</version>
  <description>Voice-driven teleop for Go2. Publishes geometry_msgs/Twist on /cmd_vel using either local NVIDIA Parakeet or Azure OpenAI Realtime function calling.</description>
  <maintainer email="n.shiba0101@gmail.com">Naoki Shibahara</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>alsa-utils</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <!--
    `azure` backend runs on both robot/Jetson and dgx-spark using the rosdep
    keys above. `parakeet` additionally needs Python runtime dependencies
    without rosdep keys (torch, nemo_toolkit, numpy), which remain installed
    only inside docker/Dockerfile.dgx-spark. See docs/adr/0003-dgx-spark-container.md.
  -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
